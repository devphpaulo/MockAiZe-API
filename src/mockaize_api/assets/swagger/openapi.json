    "/api/v1/auth/token": {
      "post": {
        "tags": [
          "Autenticacao"
        ],
        "operationId": "issueToken",
        "summary": "Emitir Bearer por 30 minutos",
        "description": "API key valida e JSON {} obrigatorios mesmo com autenticacao opcional. Nao aceita Bearer para emitir token. Sem refresh/usuarios/senhas. Body ate 4 KiB.",
        "security": [
          {
            "ApiKey": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TokenRequest"
              },
              "example": {}
            }
          }
        },
        "responses": {
          "200": {
            "description": "Token emitido; evento LOGIN_SUCCESS sem credenciais.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "405": {
            "$ref": "#/components/responses/MethodNotAllowed"
          },
          "413": {
            "$ref": "#/components/responses/PayloadTooLarge"
          },
          "415": {
            "$ref": "#/components/responses/UnsupportedMediaType"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          },
          "503": {
            "$ref": "#/components/responses/ServiceUnavailable"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key",
        "description": "Chave da instalacao, alternativa ao Bearer. Nao enviar ambos."
      },
      "Bearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "Token opaco de login, nao JWT. Cole sem prefixo Bearer; nao combinar com API key."
      }
    },
    "schemas": {
      "Health": {
        "type": "object",
        "required": [
          "status",
          "version"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "unavailable"
            ]
          },
          "version": {
            "type": "string"
          }
        }
      },
      "File": {
        "type": "object",
        "required": [
          "id",
          "name",
          "libraryPath",
          "revision"
        ],
        "properties": {
          "id": {
            "type": "string",
            "example": "file-1"
          },
          "name": {
            "type": "string",
            "example": "AMCB001"
          },
          "libraryPath": {
            "type": "string",
            "description": "Caminho lógico dentro da biblioteca do MockAíZé; não é um caminho de disco.",
            "example": "Financeiro / AMCB001"
          },
          "revision": {
            "type": "integer",
            "minimum": 1,
            "example": 1
          }
        }
      },
      "FilePage": {
        "type": "object",
        "required": [
          "items",
          "nextCursor"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/File"
            }
          },
          "nextCursor": {
            "type": "string",
            "nullable": true,
            "description": "Cursor da próxima página, ou null ao terminar. Repita o mesmo filtro q ao paginar."
          }
        }
      },
      "Modes": {
        "type": "object",
        "required": [
          "fileId",
          "fileName",
          "items"
        ],
        "properties": {
          "fileId": {
            "type": "string"
          },
          "fileName": {
            "type": "string"
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "name",
                "ready",
                "missingRequirements"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "enum": [
                    "new",
                    "return"
                  ]
                },
                "name": {
                  "type": "string"
                },
                "ready": {
                  "type": "boolean"
                },
                "missingRequirements": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      },
      "Returns": {
        "type": "object",
        "required": [
          "fileId",
          "fileName",
          "items"
        ],
        "properties": {
          "fileId": {
            "type": "string"
          },
          "fileName": {
            "type": "string"
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "name",
                "ready"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "ready": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      },
      "NewXmlRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "recordCount"
        ],
        "properties": {
          "recordCount": {
            "type": "integer",
            "minimum": 1,
            "example": 100,
            "description": "Inteiro positivo; padrao 500, limite customizavel ou desabilitado pela politica."
          },
          "delivery": {
            "type": "string",
            "enum": [
              "directory",
              "content",
              "inline"
            ],
            "default": "directory",
            "description": "directory (padrão): grava os XMLs em Saídas e retorna metadados JSON. content: retorna JSON com files[].content e fileName, sem gravar. inline: retorna o XML bruto e exige exatamente um XML final."
          },
          "expectedRevision": {
            "type": "integer",
            "minimum": 1,
            "description": "Opcional. Falha com 409 se a revisão salva da variação mudou."
          }
        }
      },
      "ReturnSelection": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "all"
                ]
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "ids"
            ],
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "ids"
                ]
              },
              "ids": {
                "type": "array",
                "minItems": 1,
                "maxItems": 20,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                }
              }
            }
          }
        ],
        "description": "Seleciona modelos, nao registros. all inclui todos os modelos salvos e falha se algum nao estiver pronto; ids seleciona explicitamente."
      },
      "ReturnXmlRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "inputXml",
          "returnSelection"
        ],
        "properties": {
          "returnSelection": {
            "$ref": "#/components/schemas/ReturnSelection"
          },
          "composition": {
            "type": "string",
            "enum": [
              "apart",
              "mixed"
            ],
            "default": "apart",
            "description": "apart gera um XML por modelo selecionado; mixed intercala os registros num XML quando os modelos são compatíveis."
          },
          "inputXml": {
            "type": "string",
            "minLength": 1,
            "description": "Obrigatorio, nao vazio. XML completo compativel com o modelo salvo. Bytes UTF-8 decodificados: padrao 2.000.000, custom ou disabled. Sem arquivo ou entrada salva como substituicao."
          },
          "delivery": {
            "type": "string",
            "enum": [
              "directory",
              "content",
              "inline"
            ],
            "default": "directory",
            "description": "directory (padrão): grava os XMLs em Saídas e retorna metadados JSON. content: retorna JSON com files[].content e fileName, sem gravar. inline: retorna o XML bruto e exige exatamente um XML final."
          },
          "expectedRevision": {
            "type": "integer",
            "minimum": 1,
            "description": "Opcional. Falha com 409 se a revisão salva da variação mudou."
          },
          "inputRecords": {
            "type": "string",
            "enum": [
              "all",
              "first"
            ],
            "default": "all",
            "description": "all usa todos; first usa somente o primeiro apos validar a estrutura e limitar o total da fonte. Modelos multiplos nao criam limite agregado."
          }
        }
      },
      "GeneratedFile": {
        "type": "object",
        "required": [
          "fileName",
          "records",
          "sha256",
          "sizeBytes",
          "sizeDisplay"
        ],
        "properties": {
          "fileName": {
            "type": "string"
          },
          "records": {
            "type": "integer",
            "minimum": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "sizeBytes": {
            "type": "integer",
            "minimum": 0
          },
          "sizeDisplay": {
            "type": "string"
          },
          "returnId": {
            "type": "string"
          },
          "returnName": {
            "type": "string"
          },
          "collisionRenamed": {
            "type": "boolean",
            "description": "true quando o nome precisou mudar para preservar um arquivo já existente."
          },
          "content": {
            "type": "string",
            "description": "XML completo em UTF-8, presente somente quando delivery=content. Não é base64. Após decodificar o JSON, pode ser reutilizado diretamente."
          }
        }
      },
      "GenerationResult": {
        "type": "object",
        "required": [
          "requestId",
          "fileId",
          "sourceRevision",
          "operation",
          "files",
          "delivery"
        ],
        "properties": {
          "requestId": {
            "type": "string",
            "format": "uuid"
          },
          "fileId": {
            "type": "string"
          },
          "sourceRevision": {
            "type": "integer",
            "minimum": 1
          },
          "operation": {
            "type": "string",
            "enum": [
              "new",
              "return"
            ]
          },
          "files": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/components/schemas/GeneratedFile"
            }
          },
          "composition": {
            "type": "string",
            "enum": [
              "apart",
              "mixed"
            ]
          },
          "returnIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "totalRecords": {
            "type": "integer"
          },
          "recordsPerReturn": {
            "type": "integer"
          },
          "delivery": {
            "type": "string",
            "enum": [
              "directory",
              "content"
            ]
          },
          "inputRecords": {
            "type": "string",
            "enum": [
              "all",
              "first"
            ],
            "description": "Presente nas respostas JSON de geração de retorno."
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "message",
              "traceId"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "traceId": {
                "type": "string"
              }
            }
          },
          "xmlPath": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        }
      },
      "TokenRequest": {
        "type": "object",
        "additionalProperties": false,
        "description": "Objeto JSON vazio, sem usuario/senha."
      },
      "TokenResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "access_token",
          "token_type",
          "expires_in"
        ],
        "properties": {
          "access_token": {
            "type": "string",
            "minLength": 1,
            "description": "Token opaco em memoria; nao persistir nem registrar."
          },
          "token_type": {
            "type": "string",
            "enum": [
              "Bearer"
            ]
          },
          "expires_in": {
            "type": "integer",
            "enum": [
              1800
            ]
          }
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Campos, tipos, filtros ou limites inválidos. fileId deve ser enviado somente na URL.",
        "headers": {
          "X-Request-ID": {
            "description": "traceId da resposta; replay de erro preserva o identificador original.",
            "schema": {
              "type": "string"
            }
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "Credencial ausente quando obrigatoria, invalida ou expirada. Login sempre exige API key valida.",
        "headers": {
          "X-Request-ID": {
            "description": "traceId da resposta; replay de erro preserva o identificador original.",
            "schema": {
              "type": "string"
            }
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "NotFound": {
        "description": "Arquivo, modelo de retorno ou rota não encontrado. Formatos ainda não implementados retornam 404.",
        "headers": {
          "X-Request-ID": {
            "description": "traceId da resposta; replay de erro preserva o identificador original.",
            "schema": {
              "type": "string"
            }
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "MethodNotAllowed": {
        "description": "Método incompatível com a rota. Consulte o cabeçalho Allow.",
        "headers": {
          "X-Request-ID": {
            "description": "traceId da resposta; replay de erro preserva o identificador original.",
            "schema": {
              "type": "string"
            }
          },
          "Allow": {
            "schema": {
              "type": "string"
            }
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "Conflict": {
        "description": "Revisao divergente, idempotencia em andamento, ou mesma operacao/chave com outro corpo/fileId.",
        "headers": {
          "X-Request-ID": {
            "description": "traceId da resposta; replay de erro preserva o identificador original.",
            "schema": {
              "type": "string"
            }
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "PayloadTooLarge": {
        "description": "XML decodificado excede o limite configurado, ou body de login excede 4 KiB. Sem teto global de saida.",
        "headers": {
          "X-Request-ID": {
            "description": "traceId da resposta; replay de erro preserva o identificador original.",
            "schema": {
              "type": "string"
            }
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "UnsupportedMediaType": {
        "description": "Envie o corpo como application/json.",
        "headers": {
          "X-Request-ID": {
            "description": "traceId da resposta; replay de erro preserva o identificador original.",
            "schema": {
              "type": "string"
            }
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "UnprocessableEntity": {
        "description": "Modelo, configuração, XML de entrada, nome gerado ou entrega incompatível. Todos os modelos selecionados precisam estar prontos.",
        "headers": {
          "X-Request-ID": {
            "description": "traceId da resposta; replay de erro preserva o identificador original.",
            "schema": {
              "type": "string"
            }
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "TooManyRequests": {
        "description": "Limite de requisições ou concorrência atingido. Tente novamente após Retry-After.",
        "headers": {
          "X-Request-ID": {
            "description": "traceId da resposta; replay de erro preserva o identificador original.",
            "schema": {
              "type": "string"
            }
          },
          "Retry-After": {
            "schema": {
              "type": "integer"
            },
            "description": "Segundos antes de tentar novamente."
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "InternalServerError": {
        "description": "Falha interna ou falha parcial de publicação. Consulte os logs com X-Request-ID.",
        "headers": {
          "X-Request-ID": {
            "description": "traceId da resposta; replay de erro preserva o identificador original.",
            "schema": {
              "type": "string"
            }
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "ServiceUnavailable": {
        "description": "Banco, diretórios, logs ou processador indisponível; geração excedeu o tempo limite; ou serviço em encerramento.",
        "headers": {
          "X-Request-ID": {
            "description": "traceId da resposta; replay de erro preserva o identificador original.",
            "schema": {
              "type": "string"
            }
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "Gone": {
        "description": "OUTPUT_EXPIRED: arquivo directory ausente ou alterado em tamanho/hash; sem regeneracao ou avanco de contador.",
        "headers": {
          "X-Request-ID": {
            "schema": {
              "type": "string"
            }
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      }
    }
  }
}
