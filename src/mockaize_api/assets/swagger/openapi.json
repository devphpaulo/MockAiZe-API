    "/api/v1/files/xml/{fileId}/new": {
      "post": {
        "tags": [
          "Geração XML"
        ],
        "operationId": "generateNewXml",
        "summary": "Gerar novos registros XML",
        "description": "Gera de 1 a 500 registros conforme as regras da variação XML salva. Informe fileId somente na URL. Escolha delivery=directory para gravar em Saídas, content para obter files[].content em JSON ou inline para receber XML diretamente. Não aceita inputXml nem inputRecords: esses campos pertencem ao modo de retorno.",
        "parameters": [
          {
            "name": "fileId",
            "in": "path",
            "required": true,
            "description": "ID retornado pela consulta do catálogo XML.",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            "example": "file-1"
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "Opcional. Repetir a mesma operação com a mesma chave e corpo reaproveita a resposta. Outra solicitação com a mesma chave gera 409. Use uma chave nova para cada geração lógica.",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[!-~]+$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NewXmlRequest"
              },
              "examples": {
                "pasta": {
                  "summary": "Gravar 100 novos registros em Saídas",
                  "value": {
                    "recordCount": 100,
                    "delivery": "directory"
                  }
                },
                "conteudo": {
                  "summary": "Receber 100 novos registros como XML dentro do JSON",
                  "value": {
                    "recordCount": 100,
                    "delivery": "content"
                  }
                },
                "xml_direto": {
                  "summary": "Receber o XML diretamente no corpo HTTP",
                  "value": {
                    "recordCount": 100,
                    "delivery": "inline"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Geração concluída. O campo delivery, e não o cabeçalho Accept, define JSON em diretório ou XML inline.",
            "headers": {
              "X-Request-ID": {
                "description": "Identificador da requisição para consulta dos logs.",
                "schema": {
                  "type": "string"
                }
              },
              "X-Idempotent-Replay": {
                "description": "true quando a resposta foi reaproveitada por idempotência.",
                "schema": {
                  "type": "boolean"
                }
              },
              "Content-Disposition": {
                "description": "Nome sugerido para download na entrega inline.",
                "schema": {
                  "type": "string"
                }
              },
              "X-Mockaize-SHA256": {
                "description": "SHA-256 do XML inline.",
                "schema": {
                  "type": "string"
                }
              },
              "X-Mockaize-Size-Bytes": {
                "description": "Tamanho em bytes do XML inline.",
                "schema": {
                  "type": "integer"
                }
              },
              "X-Mockaize-Size-Display": {
                "description": "Tamanho legível do XML inline.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GenerationResult"
                }
              },
              "application/xml": {
                "schema": {
                  "type": "string"
                },
                "example": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<Document>\n  <Record><Value>exemplo</Value></Record>\n</Document>"
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "405": {
            "$ref": "#/components/responses/MethodNotAllowed"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "413": {
            "$ref": "#/components/responses/PayloadTooLarge"
          },
          "415": {
            "$ref": "#/components/responses/UnsupportedMediaType"
          },
          "422": {
            "$ref": "#/components/responses/UnprocessableEntity"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          },
          "503": {
            "$ref": "#/components/responses/ServiceUnavailable"
          }
        }
      }
    },
    "/api/v1/files/xml/{fileId}/return": {
      "post": {
        "tags": [
          "Geração XML"
        ],
        "operationId": "generateReturnXml",
        "summary": "Gerar retorno XML",
        "description": "Gera retornos com as regras salvas, usando o XML do body (inputXml), um arquivo de Entradas (inputFilePath), ou o modelo salvo quando nenhuma entrada for enviada. inputRecords seleciona registros de entrada; returnSelection seleciona modelos. As regras de cópia/cálculo usam os valores dessa entrada; os demais geradores configurados continuam funcionando. Com delivery=content, cada item de files contém fileName e content com o XML completo, sem leitura de arquivos no cliente. Todos os modelos selecionados precisam estar prontos. inputXml e inputFilePath são mutuamente exclusivos; inputRecords=first também exige que todo o XML seja estruturalmente válido.",
        "parameters": [
          {
            "name": "fileId",
            "in": "path",
            "required": true,
            "description": "ID retornado pela consulta do catálogo XML.",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            "example": "file-1"
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "Opcional. Repetir a mesma operação com a mesma chave e corpo reaproveita a resposta. Outra solicitação com a mesma chave gera 409. Use uma chave nova para cada geração lógica.",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[!-~]+$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReturnXmlRequest"
              },
              "examples": {
                "modelo_salvo": {
                  "summary": "Usar todos os registros do modelo salvo e gravar XMLs em Saídas",
                  "value": {
                    "returnSelection": {
                      "type": "all"
                    },
                    "inputRecords": "all",
                    "composition": "apart",
                    "delivery": "directory"
                  }
                },
                "xml_enviado_todos": {
                  "summary": "Enviar XML próprio e receber todos os retornos em JSON",
                  "description": "XML ilustrativo; substitua por um XML compatível com sua configuração.",
                  "value": {
                    "inputXml": "<Document><Record><Value>valor-do-cliente-1</Value></Record><Record><Value>valor-do-cliente-2</Value></Record></Document>",
                    "inputRecords": "all",
                    "returnSelection": {
                      "type": "all"
                    },
                    "composition": "apart",
                    "delivery": "content"
                  }
                },
                "xml_enviado_primeiro": {
                  "summary": "Enviar XML próprio e usar somente seu primeiro registro",
                  "description": "Retorna um documento de um registro por modelo, dentro de files[].content. Substitua o XML ilustrativo.",
                  "value": {
                    "inputXml": "<Document><Record><Value>valor-do-cliente-1</Value></Record><Record><Value>valor-do-cliente-2</Value></Record></Document>",
                    "inputRecords": "first",
                    "returnSelection": {
                      "type": "all"
                    },
                    "composition": "apart",
                    "delivery": "content"
                  }
                },
                "xml_misto": {
                  "summary": "Todos os registros, modelos intercalados em um XML",
                  "value": {
                    "inputXml": "<Document><Record><Value>valor-do-cliente-1</Value></Record><Record><Value>valor-do-cliente-2</Value></Record></Document>",
                    "inputRecords": "all",
                    "returnSelection": {
                      "type": "all"
                    },
                    "composition": "mixed",
                    "delivery": "content"
                  }
                },
                "modelo_especifico": {
                  "summary": "Escolher um modelo e receber o XML diretamente",
                  "description": "Substitua modelo-retorno-id por um ID retornado na consulta de modelos.",
                  "value": {
                    "returnSelection": {
                      "type": "ids",
                      "ids": [
                        "modelo-retorno-id"
                      ]
                    },
                    "inputRecords": "all",
                    "composition": "apart",
                    "delivery": "inline"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Geração concluída. O campo delivery, e não o cabeçalho Accept, define JSON em diretório ou XML inline.",
            "headers": {
              "X-Request-ID": {
                "description": "Identificador da requisição para consulta dos logs.",
                "schema": {
                  "type": "string"
                }
              },
              "X-Idempotent-Replay": {
                "description": "true quando a resposta foi reaproveitada por idempotência.",
                "schema": {
                  "type": "boolean"
                }
              },
              "Content-Disposition": {
                "description": "Nome sugerido para download na entrega inline.",
                "schema": {
                  "type": "string"
                }
              },
              "X-Mockaize-SHA256": {
                "description": "SHA-256 do XML inline.",
                "schema": {
                  "type": "string"
                }
              },
              "X-Mockaize-Size-Bytes": {
                "description": "Tamanho em bytes do XML inline.",
                "schema": {
                  "type": "integer"
                }
              },
              "X-Mockaize-Size-Display": {
                "description": "Tamanho legível do XML inline.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GenerationResult"
                }
              },
              "application/xml": {
                "schema": {
                  "type": "string"
                },
                "example": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<Document>\n  <Record><Value>exemplo</Value></Record>\n</Document>"
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "405": {
            "$ref": "#/components/responses/MethodNotAllowed"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "413": {
            "$ref": "#/components/responses/PayloadTooLarge"
          },
          "415": {
            "$ref": "#/components/responses/UnsupportedMediaType"
          },
          "422": {
            "$ref": "#/components/responses/UnprocessableEntity"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          },
          "503": {
            "$ref": "#/components/responses/ServiceUnavailable"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key",
        "description": "Chave exibida ao criar a configuração da API. Nenhuma chave real é incluída nesta documentação."
      }
    },
    "schemas": {
      "Health": {
        "type": "object",
        "required": [
          "status",
          "version"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "unavailable"
            ]
          },
          "version": {
            "type": "string"
          }
        }
      },
      "File": {
        "type": "object",
        "required": [
          "id",
          "name",
          "libraryPath",
          "revision"
        ],
        "properties": {
          "id": {
            "type": "string",
            "example": "file-1"
          },
          "name": {
            "type": "string",
            "example": "AMCB001"
          },
          "libraryPath": {
            "type": "string",
            "description": "Caminho lógico dentro da biblioteca do MockAíZé; não é um caminho de disco.",
            "example": "Financeiro / AMCB001"
          },
          "revision": {
            "type": "integer",
            "minimum": 1,
            "example": 1
          }
        }
      },
      "FilePage": {
        "type": "object",
        "required": [
          "items",
          "nextCursor"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/File"
            }
          },
          "nextCursor": {
            "type": "string",
            "nullable": true,
            "description": "Cursor da próxima página, ou null ao terminar. Repita o mesmo filtro q ao paginar."
          }
        }
      },
      "Modes": {
        "type": "object",
        "required": [
          "fileId",
          "fileName",
          "items"
        ],
        "properties": {
          "fileId": {
            "type": "string"
          },
          "fileName": {
            "type": "string"
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "name",
                "ready",
                "missingRequirements"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "enum": [
                    "new",
                    "return"
                  ]
                },
                "name": {
                  "type": "string"
                },
                "ready": {
                  "type": "boolean"
                },
                "missingRequirements": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      },
      "Returns": {
        "type": "object",
        "required": [
          "fileId",
          "fileName",
          "items"
        ],
        "properties": {
          "fileId": {
            "type": "string"
          },
          "fileName": {
            "type": "string"
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "name",
                "ready"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "ready": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      },
      "NewXmlRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "recordCount"
        ],
        "properties": {
          "recordCount": {
            "type": "integer",
            "minimum": 1,
            "maximum": 500,
            "example": 100
          },
          "delivery": {
            "type": "string",
            "enum": [
              "directory",
              "content",
              "inline"
            ],
            "default": "directory",
            "description": "directory (padrão): grava os XMLs em Saídas e retorna metadados JSON. content: retorna JSON com files[].content e fileName, sem gravar. inline: retorna o XML bruto e exige exatamente um XML final."
          },
          "expectedRevision": {
            "type": "integer",
            "minimum": 1,
            "description": "Opcional. Falha com 409 se a revisão salva da variação mudou."
          }
        }
      },
      "ReturnSelection": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "all"
                ]
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "ids"
            ],
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "ids"
                ]
              },
              "ids": {
                "type": "array",
                "minItems": 1,
                "maxItems": 20,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                }
              }
            }
          }
        ],
        "description": "Seleciona modelos de retorno, não registros de entrada. Use inputRecords para escolher todos os registros ou apenas o primeiro."
      },
      "ReturnXmlRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "returnSelection"
        ],
        "not": {
          "required": [
            "inputXml",
            "inputFilePath"
          ]
        },
        "properties": {
          "returnSelection": {
            "$ref": "#/components/schemas/ReturnSelection"
          },
          "composition": {
            "type": "string",
            "enum": [
              "apart",
              "mixed"
            ],
            "default": "apart",
            "description": "apart gera um XML por modelo selecionado; mixed intercala os registros num XML quando os modelos são compatíveis."
          },
          "inputXml": {
            "type": "string",
            "minLength": 1,
            "description": "XML completo enviado pelo cliente no corpo JSON, até 2 MB em UTF-8. A estrutura deve ser compatível com a entrada configurada; valores e quantidade de registros podem mudar. As regras salvas de cópia e cálculo de entrada passam a usar estes valores. Não combinar com inputFilePath. Se ambas as entradas forem omitidas, usa o XML de exemplo salvo no banco."
          },
          "inputFilePath": {
            "type": "string",
            "minLength": 1,
            "description": "Caminho absoluto de um XML contido no diretório Entradas configurado no servidor. O arquivo deve existir e ser acessível pelo serviço. Não é um upload nem um caminho do computador cliente. Não combinar com inputXml."
          },
          "delivery": {
            "type": "string",
            "enum": [
              "directory",
              "content",
              "inline"
            ],
            "default": "directory",
            "description": "directory (padrão): grava os XMLs em Saídas e retorna metadados JSON. content: retorna JSON com files[].content e fileName, sem gravar. inline: retorna o XML bruto e exige exatamente um XML final."
          },
          "expectedRevision": {
            "type": "integer",
            "minimum": 1,
            "description": "Opcional. Falha com 409 se a revisão salva da variação mudou."
          },
          "inputRecords": {
            "type": "string",
            "enum": [
              "all",
              "first"
            ],
            "default": "all",
            "description": "all gera para todos os registros do XML de entrada; first usa somente o primeiro grupo de registro configurado. Vale para inputXml, inputFilePath e para o modelo salvo. O XML inteiro é validado antes da seleção. Não confundir com returnSelection, que escolhe modelos de retorno."
          }
        }
      },
      "GeneratedFile": {
        "type": "object",
        "required": [
          "fileName",
          "records",
          "sha256",
          "sizeBytes",
          "sizeDisplay"
        ],
        "properties": {
          "fileName": {
            "type": "string"
          },
          "records": {
            "type": "integer",
            "minimum": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "sizeBytes": {
            "type": "integer",
            "minimum": 0
          },
          "sizeDisplay": {
            "type": "string"
          },
          "returnId": {
            "type": "string"
          },
          "returnName": {
            "type": "string"
          },
          "collisionRenamed": {
            "type": "boolean",
            "description": "true quando o nome precisou mudar para preservar um arquivo já existente."
          },
          "content": {
            "type": "string",
            "description": "XML completo em UTF-8, presente somente quando delivery=content. Não é base64. Após decodificar o JSON, pode ser reutilizado diretamente."
          }
        }
      },
      "GenerationResult": {
        "type": "object",
        "required": [
          "requestId",
          "fileId",
          "sourceRevision",
          "operation",
          "files",
          "delivery"
        ],
        "properties": {
          "requestId": {
            "type": "string",
            "format": "uuid"
          },
          "fileId": {
            "type": "string"
          },
          "sourceRevision": {
            "type": "integer",
            "minimum": 1
          },
          "operation": {
            "type": "string",
            "enum": [
              "new",
              "return"
            ]
          },
          "files": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/components/schemas/GeneratedFile"
            }
          },
          "composition": {
            "type": "string",
            "enum": [
              "apart",
              "mixed"
            ]
          },
          "returnIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "totalRecords": {
            "type": "integer"
          },
          "recordsPerReturn": {
            "type": "integer"
          },
          "delivery": {
            "type": "string",
            "enum": [
              "directory",
              "content"
            ]
          },
          "inputRecords": {
            "type": "string",
            "enum": [
              "all",
              "first"
            ],
            "description": "Presente nas respostas JSON de geração de retorno."
          }
        }
      },
      "Problem": {
        "type": "object",
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "code",
          "requestId"
        ],
        "properties": {
          "type": {
            "type": "string",
            "example": "about:blank"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "detail": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "requestId": {
            "type": "string",
            "format": "uuid"
          },
          "xmlPath": {},
          "reason": {}
        }
      }
    },
    "responses": {
      "BadRequest": {
