    "/api/v1/files/xml/{fileId}/new": {
      "post": {
        "tags": [
          "Geração XML"
        ],
        "operationId": "generateNewXml",
        "summary": "Gerar novos registros XML",
        "description": "recordCount inteiro positivo, padrao 500, custom ou disabled. fileId somente na URL; nao aceita inputXml/inputFilePath/inputRecords/seed/context. delivery define directory/content/inline.",
        "parameters": [
          {
            "name": "fileId",
            "in": "path",
            "required": true,
            "description": "ID retornado pela consulta do catálogo XML.",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            "example": "file-1"
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "Escopo por operacao: mesma operacao/chave/corpo preserva resposta; outro corpo/fileId na mesma operacao da 409. Arquivo removido/alterado da 410 sem regenerar.",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[!-~]+$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NewXmlRequest"
              },
              "examples": {
                "pasta": {
                  "summary": "Gravar 100 novos registros em Saídas",
                  "value": {
                    "recordCount": 100,
                    "delivery": "directory"
                  }
                },
                "conteudo": {
                  "summary": "Receber 100 novos registros como XML dentro do JSON",
                  "value": {
                    "recordCount": 100,
                    "delivery": "content"
                  }
                },
                "xml_direto": {
                  "summary": "Receber o XML diretamente no corpo HTTP",
                  "value": {
                    "recordCount": 100,
                    "delivery": "inline"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Geração concluída. O campo delivery, e não o cabeçalho Accept, define JSON em diretório ou XML inline.",
            "headers": {
              "X-Request-ID": {
                "description": "Identificador da requisição para consulta dos logs.",
                "schema": {
                  "type": "string"
                }
              },
              "X-Idempotent-Replay": {
                "description": "true quando a resposta foi reaproveitada por idempotência.",
                "schema": {
                  "type": "boolean"
                }
              },
              "Content-Disposition": {
                "description": "Nome sugerido para download na entrega inline.",
                "schema": {
                  "type": "string"
                }
              },
              "X-Mockaize-SHA256": {
                "description": "SHA-256 do XML inline.",
                "schema": {
                  "type": "string"
                }
              },
              "X-Mockaize-Size-Bytes": {
                "description": "Tamanho em bytes do XML inline.",
                "schema": {
                  "type": "integer"
                }
              },
              "X-Mockaize-Size-Display": {
                "description": "Tamanho legível do XML inline.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GenerationResult"
                }
              },
              "application/xml": {
                "schema": {
                  "type": "string"
                },
                "example": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<Document>\n  <Record><Value>exemplo</Value></Record>\n</Document>"
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "405": {
            "$ref": "#/components/responses/MethodNotAllowed"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "413": {
            "$ref": "#/components/responses/PayloadTooLarge"
          },
          "415": {
            "$ref": "#/components/responses/UnsupportedMediaType"
          },
          "422": {
            "$ref": "#/components/responses/UnprocessableEntity"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          },
          "503": {
            "$ref": "#/components/responses/ServiceUnavailable"
          },
          "410": {
            "$ref": "#/components/responses/Gone"
          }
        }
      }
    },
    "/api/v1/files/xml/{fileId}/return": {
      "post": {
        "tags": [
          "Geração XML"
        ],
        "operationId": "generateReturnXml",
        "summary": "Gerar retorno XML",
        "description": "inputXml e returnSelection obrigatorios. Sem entrada salva ou inputFilePath. Valida e limita toda a fonte antes de first. Todos os modelos selecionados precisam estar prontos; mixed nao impoe limite agregado. delivery define entrega.",
        "parameters": [
          {
            "name": "fileId",
            "in": "path",
            "required": true,
            "description": "ID retornado pela consulta do catálogo XML.",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            "example": "file-1"
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "Escopo por operacao: mesma operacao/chave/corpo preserva resposta; outro corpo/fileId na mesma operacao da 409. Arquivo removido/alterado da 410 sem regenerar.",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[!-~]+$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReturnXmlRequest"
              },
              "examples": {
                "xml_enviado_todos": {
                  "summary": "Enviar XML próprio e receber todos os retornos em JSON",
                  "description": "XML ilustrativo; substitua por um XML compatível com sua configuração.",
                  "value": {
                    "inputXml": "<Document><Record><Value>valor-1</Value></Record><Record><Value>valor-2</Value></Record></Document>",
                    "inputRecords": "all",
                    "returnSelection": {
                      "type": "all"
                    },
                    "composition": "apart",
                    "delivery": "content"
                  }
                },
                "xml_enviado_primeiro": {
                  "summary": "Enviar XML próprio e usar somente seu primeiro registro",
                  "description": "Retorna um documento de um registro por modelo, dentro de files[].content. Substitua o XML ilustrativo.",
                  "value": {
                    "inputXml": "<Document><Record><Value>valor-1</Value></Record><Record><Value>valor-2</Value></Record></Document>",
                    "inputRecords": "first",
                    "returnSelection": {
                      "type": "all"
                    },
                    "composition": "apart",
                    "delivery": "content"
                  }
                },
                "xml_misto": {
                  "summary": "Todos os registros, modelos intercalados em um XML",
                  "value": {
                    "inputXml": "<Document><Record><Value>valor-1</Value></Record><Record><Value>valor-2</Value></Record></Document>",
                    "inputRecords": "all",
                    "returnSelection": {
                      "type": "all"
                    },
                    "composition": "mixed",
                    "delivery": "content"
                  }
                },
                "modelo_especifico": {
                  "summary": "Escolher um modelo e receber o XML diretamente",
                  "description": "ret-a pertence a fixture sintetica. Substitua pelo ID da consulta de modelos.",
                  "value": {
                    "returnSelection": {
                      "type": "ids",
                      "ids": [
                        "ret-a"
                      ]
                    },
                    "inputRecords": "all",
                    "composition": "apart",
                    "delivery": "inline",
                    "inputXml": "<Document><Record><Value>valor-1</Value></Record><Record><Value>valor-2</Value></Record></Document>"
                  }
                },
                "pasta": {
                  "summary": "Enviar XML e gravar um retorno por modelo em Saidas",
                  "value": {
                    "returnSelection": {
                      "type": "all"
                    },
                    "inputRecords": "all",
                    "composition": "apart",
                    "delivery": "directory",
                    "inputXml": "<Document><Record><Value>valor-1</Value></Record><Record><Value>valor-2</Value></Record></Document>"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Geração concluída. O campo delivery, e não o cabeçalho Accept, define JSON em diretório ou XML inline.",
            "headers": {
              "X-Request-ID": {
                "description": "Identificador da requisição para consulta dos logs.",
                "schema": {
                  "type": "string"
                }
              },
              "X-Idempotent-Replay": {
                "description": "true quando a resposta foi reaproveitada por idempotência.",
                "schema": {
                  "type": "boolean"
                }
              },
              "Content-Disposition": {
                "description": "Nome sugerido para download na entrega inline.",
                "schema": {
                  "type": "string"
                }
              },
              "X-Mockaize-SHA256": {
                "description": "SHA-256 do XML inline.",
                "schema": {
                  "type": "string"
                }
              },
              "X-Mockaize-Size-Bytes": {
                "description": "Tamanho em bytes do XML inline.",
                "schema": {
                  "type": "integer"
                }
              },
              "X-Mockaize-Size-Display": {
                "description": "Tamanho legível do XML inline.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GenerationResult"
                }
              },
