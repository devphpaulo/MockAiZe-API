    "/api/v1/files/xml": {
      "get": {
        "tags": [
          "Catálogo XML"
        ],
        "operationId": "listXmlFiles",
        "summary": "Consultar catálogo XML",
        "description": "Retorna somente as variações visíveis da biblioteca XML. A seleção do formato é feita no caminho /files/xml; filtros e paginação usam a query.",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "description": "Filtrar por trecho do nome, sem diferenciar maiúsculas e minúsculas.",
            "schema": {
              "type": "string",
              "maxLength": 512,
              "default": ""
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200,
              "default": 100
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "description": "Use nextCursor da resposta anterior com o mesmo q. Omita na primeira página.",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Consulta concluída.",
            "headers": {
              "X-Request-ID": {
                "description": "Identificador da requisição para consulta dos logs.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FilePage"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "405": {
            "$ref": "#/components/responses/MethodNotAllowed"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          },
          "503": {
            "$ref": "#/components/responses/ServiceUnavailable"
          }
        }
      }
    },
