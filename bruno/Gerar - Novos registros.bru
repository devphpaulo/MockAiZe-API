meta {
  name: Gerar - Novos registros
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/v1/files/xml/{{fileId}}/new
  body: json
  auth: none
}

headers {
  X-API-Key: {{apiKey}}
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {
    "recordCount": 100,
    "delivery": "directory"
  }
}

docs {
  Gera 100 registros para a variação da URL e salva o XML no diretório Saídas do servidor. Ajuste recordCount (1 a 500). Use delivery content para receber files[].content no JSON sem gravar, ou inline para receber o XML diretamente.
}
