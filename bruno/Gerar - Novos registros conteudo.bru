meta {
  name: Gerar - Novos registros com conteudo
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/api/v1/files/xml/{{fileId}}/new
  body: json
  auth: none
}

headers {
  X-API-Key: {{apiKey}}
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "recordCount": 100,
    "delivery": "content"
  }
}

docs {
  Devolve JSON com fileName e content (o XML completo) em cada item de files. Não grava arquivos em Saídas. As regras da variação continuam sendo aplicadas.
}
