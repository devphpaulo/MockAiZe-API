meta {
  name: Catalog - Arquivos com Bearer
  type: http
  seq: 11
}

get {
  url: {{baseUrl}}/api/v1/files/xml
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{accessToken}}
  Accept: application/json
}

docs {
  Execute Auth - Login antes. Envia somente Bearer, como alternativa à API key. Expiração retorna 401; credencial inválida também é rejeitada se a autenticação estiver opcional. Não imprima ou persista accessToken.
}
