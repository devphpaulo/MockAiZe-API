meta {
  name: Gerar - Retorno com XML enviado e todos os registros
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/api/v1/files/xml/{{fileId}}/return
  body: json
  auth: none
}

headers {
  X-API-Key: {{apiKey}}
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "inputXml": "<Document><Record><Value>valor-1</Value></Record><Record><Value>valor-2</Value></Record></Document>",
    "inputRecords": "all",
    "returnSelection": {
      "type": "all"
    },
    "composition": "apart",
    "delivery": "content"
  }
}

docs {
  inputXml é obrigatório: substitua o exemplo por um XML compatível com a estrutura configurada. Cópias e cálculos usam os valores enviados. Gera para todos os registros e todos os modelos salvos, devolvendo files[].content sem gravar em Saídas. Um modelo não pronto faz a chamada falhar. Não aceita inputFilePath ou entrada salva como substituição. O limite de registros considera a fonte completa antes de inputRecords first.
}
