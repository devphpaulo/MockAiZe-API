meta {
  name: Gerar - Retorno
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/v1/return
  body: json
  auth: none
}

headers {
  X-API-Key: {{apiKey}}
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {
    "fileId": "{{fileId}}",
    "returnSelection": {
      "type": "all"
    },
    "composition": "apart"
  }
}

docs {
  Gera arquivos para todos os modelos de retorno prontos, usando o modelo XML da biblioteca, e salva os resultados no diretório de saída. Para selecionar modelos específicos, use returnSelection com type ids e uma lista ids. Para enviar XML, inclua inputXml; para usar um arquivo de entrada, inclua inputFilePath.
}
