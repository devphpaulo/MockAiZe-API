meta {
  name: Gerar - Retorno
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/v1/files/xml/{{fileId}}/return
  body: json
  auth: none
}

headers {
  X-API-Key: {{apiKey}}
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {
    "inputXml": "<Document><Record><Value>valor-1</Value></Record><Record><Value>valor-2</Value></Record></Document>",
    "returnSelection": {
      "type": "all"
    },
    "composition": "apart",
    "inputRecords": "all",
    "delivery": "directory"
  }
}

docs {
  inputXml é obrigatório e deve ser compatível com o modelo da sua variação. Gera para todos os registros e todos os modelos salvos; falha se algum modelo selecionado não estiver pronto. Salva um XML por modelo em Saídas. Não aceita inputFilePath nem substitui a entrada por XML salvo. inputRecords seleciona registros; returnSelection seleciona modelos. delivery content retorna XML dentro do JSON.
}
