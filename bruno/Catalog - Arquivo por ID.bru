meta {
  name: Catalog - Arquivo por ID
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/v1/files/xml/{{fileId}}
  body: none
  auth: none
}

headers {
  X-API-Key: {{apiKey}}
  Accept: application/json
}

docs {
  Consulta os metadados de uma variação XML pelo ID da URL. O identificador é obtido em Catalog - Arquivos. Não expõe o modelo XML nem a configuração interna.
}
